{
  "name": "@eslint-sh/ast-services",
  "description": "Non-lint services over the sh-ast shell parser: whole-file formatting with mvdan/sh's printer",
  "version": "0.0.0",
  "private": true,
  "author": "Mike North <michael.l.north@gmail.com>",
  "dependencies": {
    "sh-ast": "^0.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ast-services.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/ast-services.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bash",
    "format",
    "formatter",
    "shell",
    "shfmt"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist/**/*.js",
          "{projectRoot}/dist/**/*.js.map",
          "{projectRoot}/dist/**/*.d.ts",
          "{projectRoot}/dist/**/*.d.ts.map",
          "{projectRoot}/dist/cjs/package.json",
          "!{projectRoot}/dist/ast-services.d.ts"
        ]
      },
      "check:api-report": {
        "outputs": [
          "{projectRoot}/api-report",
          "{projectRoot}/temp",
          "{projectRoot}/dist/ast-services.d.ts",
          "{projectRoot}/dist/cjs/ast-services.d.cts"
        ]
      },
      "uplevel-api-reports": {
        "dependsOn": [
          "check:api-report"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/api-report/**",
          "{projectRoot}/temp/**"
        ],
        "outputs": [
          "{workspaceRoot}/api-report-combined/ast-services.api.md",
          "{workspaceRoot}/api-docs-temp/ast-services.api.json"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.mjs",
    "check": "concurrently -n lint,types,api-report \"pnpm run check:lint-ts\" \"pnpm run check:typecheck\" \"pnpm run check:api-report\"",
    "check:api-report": "api-extractor run && node scripts/copy-cjs-types.mjs",
    "check:lint-ts": "eslint .",
    "check:typecheck": "tsc --noEmit",
    "clean": "rimraf --glob dist \"temp/*\" \"*.tsbuildinfo\"",
    "fix:api-report": "api-extractor run --local && node scripts/copy-cjs-types.mjs",
    "fix:lint-ts": "eslint . --fix",
    "prepack": "api-extractor run && node scripts/copy-cjs-types.mjs",
    "test": "vitest run",
    "uplevel-api-reports": "mkdir -p ../../api-report-combined ../../api-docs-temp && cp api-report/ast-services.api.md ../../api-report-combined/ && cp temp/ast-services.api.json ../../api-docs-temp/"
  },
  "type": "module",
  "types": "./dist/ast-services.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/eslint-sh.git",
    "directory": "packages/ast-services"
  }
}
